{
  "name": "@software-factory/plato",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PLATO activity diagrams: natural-language requirements to PlantUML and PNG via Software Factory Runtime",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "vendor/",
    "python/",
    "agent-registration.json",
    "icon.svg",
    "locale/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare:python": "node scripts/prepare-python.mjs",
    "debug": "node scripts/debug.ts",
    "pack:plugin": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@software-factory/runtime-sdk": "file:vendor/software-factory-runtime-sdk-0.1.0.tgz"
  },
  "bundledDependencies": ["@software-factory/runtime-sdk"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.2",
    "@software-factory/runtime": "file:test-runtime-cache/software-factory-runtime-0.1.0.tgz",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
